{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"formatter": {
		"enabled": true,
		"formatWithErrors": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"noNextAsyncClientComponent": "off",
				"noUnusedVariables": "off",
				"noUnusedFunctionParameters": "off",
				"useParseIntRadix": "off"
			},
			"suspicious": {
				"noAsyncPromiseExecutor": "off",
				"useAwait": "off",
				"useIterableCallbackReturn": "off",
				"noGlobalIsNan": "off"
			},
			"complexity": {
				"noThisInStatic": "off",
				"useOptionalChain": "off",
				"useLiteralKeys": "off"
			},
			"style": {
				"useTemplate": "off"
			}
		}
	},
	"assist": {
		"enabled": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"./**/*.{js,mjs,ts,mts,json,css,html,}",
			"!!ObsidianRnDVault/.obsidian",
			"!!Docs"
		]
	},
	"json": {
		"formatter": {
			"enabled": true
		},
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		}
	},
	"javascript": {
		"globals": ["app"],
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": false,
		"useIgnoreFile": true
	}
}
